{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "flux": {
    "managerFilePatterns": ["/cluster/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/cluster/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".forgejo/**", "biome.jsonc"],
      "matchUpdateTypes": ["!major"]
    }
  ]
}
