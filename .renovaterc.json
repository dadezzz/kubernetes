{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["davide"],
  "extends": [
    "config:best-practices",
    "customManagers:dockerfileVersions",
    ":semanticCommits"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/cluster/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "automerge": true,
      "groupName": "CI dependencies",
      "groupSlug": "ci",
      "matchFileNames": [".forgejo/**"],
      "matchUpdateTypes": ["!major"]
    }
  ],
  // Raise limit or there are situations where we can't keep up with the number
  // of deps to update.
  "prHourlyLimit": 6
}
