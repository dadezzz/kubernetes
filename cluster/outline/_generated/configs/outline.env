# For integration with Forgejo
ALLOWED_PRIVATE_IP_ADDRESSES=100.64.0.0/10
AWS_REGION=auto
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_UPLOAD_BUCKET_NAME=outline
# Required for R2.
AWS_S3_UPLOAD_METHOD=put
# Handled by Renovate.
ENABLE_UPDATES=false
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000
FILE_STORAGE=s3
OIDC_AUTH_URI=https://id.zarantonello.dev/authorize
OIDC_DISPLAY_NAME=PocketId
OIDC_LOGOUT_URI=https://id.zarantonello.dev/api/oidc/end-session
OIDC_SCOPES=openid profile email
OIDC_TOKEN_URI=https://id.zarantonello.dev/api/oidc/token
OIDC_USERINFO_URI=https://id.zarantonello.dev/api/oidc/userinfo
OIDC_USERNAME_CLAIM=preferred_username
PGSSLMODE=disable
REDIS_URL=redis://redis.outline.svc.k8s.zarantonello.dev:6379
SMTP_FROM_EMAIL=Outline <docs@zarantonello.dev>
SMTP_HOST=mail.zarantonello.dev
SMTP_PORT=465
SMTP_SECURE=true
URL=https://docs.zarantonello.dev
