#!/usr/bin/env bash

# This is a wrapper script that adds the nv12 and hwupload filters to ffmepg.
# Needed because immich passes videos in yuv420 pixel format and we need nv12.

set -euo pipefail

args=("$@")
encoder=""
has_vf=0
vf_index=-1
hw_decode=0

for i in "${!args[@]}"; do
  case "${args[$i]}" in
    -c:v)
      next=$((i + 1))
      encoder="${args[$next]:-}"
      ;;
    -vf | -filter:v)
      has_vf=1
      vf_index=$((i + 1))
      ;;
    -hwaccel_output_format)
      next=$((i + 1))
      if [[ "${args[$next]:-}" == "vaapi" ]]; then
        hw_decode=1
      fi
      ;;
  esac
done

if [[ "$encoder" == *_vaapi ]] && [[ "$hw_decode" -eq 0 ]]; then
  if [[ "$has_vf" -eq 1 ]]; then
    current_vf="${args[$vf_index]}"
    if [[ "$current_vf" != *"format=nv12"* ]]; then
      if [[ "$current_vf" == *"hwupload"* ]]; then
        # insert format=nv12 right before the existing hwupload
        args[$vf_index]="${current_vf/hwupload/format=nv12,hwupload}"
      else
        args[$vf_index]="${current_vf},format=nv12,hwupload"
      fi
    fi
  else
    args+=(-vf "format=nv12,hwupload")
  fi
fi

# Preserve library paths for Jellyfin-FFmpeg
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:/usr/lib/jellyfin-ffmpeg/lib"

exec /usr/lib/jellyfin-ffmpeg/ffmpeg "${args[@]}"
