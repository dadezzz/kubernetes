FORGEJO__admin__SEND_NOTIFICATION_EMAIL_ON_NEW_USER=true

FORGEJO__api__ENABLE_SWAGGER=false

FORGEJO__cache__ADAPTER=twoqueue
FORGEJO__cache__HOST={ "size": 100, "recent_ratio": 0.25, "ghost_ratio": 0.5 }

# We have a lot of floating tags (latest, ci) that need to be present even
# after a new version has been pushed and renovate hasn't updated the
# reference digest yet.
FORGEJO__cron_0x2e_cleanup_packages__ENABLED=true
FORGEJO__cron_0x2e_cleanup_packages__OLDER_THAN=96h
FORGEJO__cron_0x2e_update_checker__ENABLED=false

FORGEJO__database__DB_TYPE=sqlite3

FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__FROM=Forgejo <git@zarantonello.dev>
FORGEJO__mailer__PROTOCOL=smtps
FORGEJO__mailer__SMTP_ADDR=stalwart.stalwart.svc.k8s.zarantonello.dev
FORGEJO__mailer__SMTP_PORT=465

FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false

FORGEJO__repository_0x2e_signing__CRUD_ACTIONS=pubkey,twofa
FORGEJO__repository_0x2e_signing__DEFAULT_TRUST_MODEL=committer
FORGEJO__repository_0x2e_signing__FORMAT=ssh
FORGEJO__repository_0x2e_signing__INITIAL_COMMIT=pubkey,twofa
FORGEJO__repository_0x2e_signing__MERGES=pubkey,twofa
FORGEJO__repository_0x2e_signing__SIGNING_EMAIL=git@zarantonello.dev
FORGEJO__repository_0x2e_signing__SIGNING_KEY=/var/lib/gitea/ssh/signing.ed25519.pub
FORGEJO__repository_0x2e_signing__SIGNING_NAME=Forgejo

FORGEJO__repository__DEFAULT_PRIVATE=private
FORGEJO__repository__DISABLED_REPO_UNITS=repo.ext_issues,repo.ext_wiki
FORGEJO__repository__DISABLE_STARS=true

FORGEJO__security__GLOBAL_TWO_FACTOR_REQUIREMENT=admin
# Disable when running for the first time, then re-enable it right after
# installation has finished.
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__security__MIN_PASSWORD_LENGTH=12
FORGEJO__security__PASSWORD_COMPLEXITY=lower,digit,spec

FORGEJO__server__DISABLE_SSH=true
FORGEJO__server__DOMAIN=git.zarantonello.dev
FORGEJO__server__ROOT_URL=https://git.zarantonello.dev/

FORGEJO__service_0x2e_explore__DISABLE_USERS_PAGE=true

FORGEJO__service__ALLOW_ONLY_INTERNAL_REGISTRATION=true
FORGEJO__service__CAPTCHA_TYPE=cfturnstile
FORGEJO__service__DEFAULT_ALLOW_CREATE_ORGANIZATION=false
FORGEJO__service__DISABLE_REGISTRATION=false
FORGEJO__service__ENABLE_BASIC_AUTHENTICATION=false
FORGEJO__service__ENABLE_CAPTCHA=true
FORGEJO__service__ENABLE_NOTIFY_MAIL=true
FORGEJO__service__REGISTER_MANUAL_CONFIRM=true
FORGEJO__service__REQUIRE_CAPTCHA_FOR_LOGIN=true

FORGEJO__session__PROVIDER=db
